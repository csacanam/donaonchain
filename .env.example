# ---------------------------------------------------------------- Voulti
# From app.voulti.com → Receive Payments → Developers.
# Until this is set, the site renders fine but refuses to take money.
VOULTI_COMMERCE_ID=

# Webhook signing secret, same Developers page. Without it the webhook route
# rejects every delivery — which is correct, but means the counter only moves
# via the thank-you page's polling backstop.
#
# This one serves the legacy single-commerce URL, /api/webhooks/voulti.
VOULTI_WEBHOOK_SECRET=

# Per-commerce secrets, for /api/webhooks/voulti/<commerce>.
#
# The secret is issued per commerce and the delivery carries no commerce_id, so
# two commerces cannot share one endpoint — the second would fail signature
# verification. Each gets its own URL, and the URL selects the secret:
#   https://www.donaonchain.com/api/webhooks/voulti/peewah
#   https://www.donaonchain.com/api/webhooks/voulti/reficolombia
# Set only the ones you actually run; an unset slug rejects every delivery.
VOULTI_WEBHOOK_SECRET_PEEWAH=
VOULTI_WEBHOOK_SECRET_REFICOLOMBIA=

# ------------------------------------------------------------------ Redis
# Injected automatically by the Vercel Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -------------------------------------------------------------- HashProof
# Certificates cost $0.10 USDC each and stay off until BOTH this flag is
# "true" AND a funded wallet key (or API key) exists.
HASHPROOF_ENABLED=false
HASHPROOF_WALLET_PRIVATE_KEY=
# Alternative to the wallet, for prepaid credits: hi@hashproof.dev
# HASHPROOF_API_KEY=
# eip155:8453 = Base, eip155:42220 = Celo. Wallet must hold USDC on this chain.
HASHPROOF_PAY_NETWORK=eip155:8453
HASHPROOF_ISSUER_NAME=DonaOnchain
HASHPROOF_ISSUER_SLUG=donaonchain

# ------------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=https://donaonchain.com
NEXT_PUBLIC_CONTACT_EMAIL=hola@donaonchain.com

# ---------------------------------------------------------------- Addresses
# Where Voulti settles donations. MUST be a normal wallet (EOA), never a Safe:
# Voulti settles to one address on every enabled network, and a Safe deployed
# on one chain does not exist at that address on the others — funds paid on a
# chain where the contract is absent can be stranded.
NEXT_PUBLIC_INTAKE_ADDRESS=

# The multi-signature treasury the intake wallet is swept into.
NEXT_PUBLIC_TREASURY_ADDRESS=

# --------------------------------------------------------- On-chain reader
# Comma-separated chain keys to scan: celo,base,arbitrum,polygon,bsc
# Defaults to celo alone. Only list chains you actually enabled in Voulti —
# each one costs a round of RPC calls on every cache refresh.
ONCHAIN_CHAINS=celo

# Where to begin scanning, PER CHAIN. Block heights are not comparable across
# networks, so one shared value cannot work: applied to a chain whose head is
# lower it puts the cursor past the head and the scan returns nothing.
# Set each to roughly the block height at campaign launch. Leave blank to scan
# only a recent window (older history then never appears).
ONCHAIN_START_CELO=
ONCHAIN_START_BASE=
ONCHAIN_START_ARBITRUM=
ONCHAIN_START_POLYGON=
ONCHAIN_START_BSC=

# Optional RPC overrides. The built-in defaults were verified working on
# 2026-08-11; note that polygon-rpc.com and bsc-dataseed were NOT usable for
# eth_getLogs, which is why the defaults point elsewhere.
# RPC_CELO=
# RPC_BASE=
# RPC_ARBITRUM=
# RPC_POLYGON=
# RPC_BSC=
